<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign paths = "/,/archive/,/compare/,/gallery/,/about/,/learn/" | split: "," %}{% for path in paths %}
  <url><loc>{{ path | absolute_url | xml_escape }}</loc></url>
{% endfor %}{% for model in site.data.models %}
  <url><loc>{{ '/archive/' | append: model.id | append: '/' | absolute_url | xml_escape }}</loc></url>
{% endfor %}
</urlset>
